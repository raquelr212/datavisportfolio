#Visual 7a Shifting State Resettlement Types 
#--------------------------------------------------------------------------------------------------------------------------------------------------------
URWFEO1996_2019update <- read_excel("input/URWFEO1996-2019update.xls")
View(URWFEO1996_2019update)                                                                            

WFagain <- read_excel("input/WFagain.xls")
View(WFagain)

wf2005_2019 <- filter(WFagain, year>2004)
View(wf2005_2019)

wfyears2005_2019$state.fac <- as.factor(wfyears2005_2019$state)
wfyears2005_2019$state.fac <- fct_rev(wfyears2005_2019$state.fac)

wf2005_2019 <- wf2005_2019 %>% 
  mutate(newwf=if_else(wf==0,"no","yes"))

wf2005_2019$state.fac <- as.factor(wf2005_2019$state)
wf2005_2019$state.fac <- fct_rev(wf2005_2019$state.fac)

ggplot(data=wf2005_2019,
       mapping=aes(x=year,
                   y=state.fac))+
  geom_tile(aes(fill=newwf),
            alpha=.5)+
  scale_fill_manual(values=c(no ="#377EB8",
                             yes ="#FFA51C"),
                    labels=c("no"="Traditional Model",
                             "yes"="Wilson/Fish Model"))+
  theme(axis.title.x=element_blank(),
        axis.title.y=element_blank(),
        axis.ticks.y=element_blank(),
        panel.background=element_blank())+
  labs(title = "In the past 15 years, only two states have opted to move to Wilson/Fish resettlement models",
       subtitle = "Most states operating with Wilson/Fish have been doing so for decades.",
       caption = "Source: Office of Refugee Resettlement Annual Reports to Congress 2005-2019")
