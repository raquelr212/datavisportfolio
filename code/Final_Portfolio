#Visual 2 MA ELL Proficiency Scores
#--------------------------------------------------------------------------------------------------------------------------------------------------------
#read in and view data 
MA_Scores <- read_excel("input/MA_Scores.xlsx", 
                        sheet = "Sheet2")
View(MA_Scores)

#create visual to depict exam results among ELL students in MA
ggplot()+
  geom_rect(aes(xmin="2015-2016",
                xmax="2018-2019",
                ymin=-Inf,
                ymax=Inf),
            fill="gray",
            alpha=.2)+
  geom_line(data=MA_Scores, mapping=aes(x=Year, y =PercentPass, group=Status, color=Status),
            size=.8)+
  geom_point(data=MA_Scores, mapping=aes(x=Year, y=PercentPass, group=Status, color=Status))+
  theme_minimal()+
  labs(y="Percent of ELL Students",
       title = "English Language Proficiency Exam Results for English Learner Students in MA",
                          "2012-2019",
            caption = "Source: U.S. Department of Education | ED Data Express")
#--------------------------------------------------------------------------------------------------------------------------------------------------------
#Visual 3 MA ELL and Ranking Proportions
#--------------------------------------------------------------------------------------------------------------------------------------------------------
#read in and view data
MA_high_schools <- read_excel("input/MA_high_schools.xlsx",
                              sheet = "Sheet3")
View(MA_high_schools)

#create visual to depict high school rankings and ELL enrollment 
ggplot(data=MA_high_schools,
       aes(x=Rank, y=pct, fill=ID))+
  geom_bar(stat="identity")+
  theme(plot.margin=unit(c(1,1,1,1), "cm"))+
  geom_text(aes(label=pct),
            position=position_stack(vjust=.5))+
  labs(title="Proportion of English Learner Students in Highest and Lowest Ranking Schools, and Statewide",
       subtitle="The highest ranked schools tend to have the fewest ELL students",
       caption="Source: Massachusetts Department of Elementary and Secondary Education")+
  theme(axis.title.x=element_blank(),
        axis.title.y=element_blank(),
        axis.ticks.x=element_blank(),
        axis.ticks.y=element_blank(),
        axis.text.y=element_blank(),
        panel.background=element_blank())
#--------------------------------------------------------------------------------------------------------------------------------------------------------
#Visual 4 MA ELL students and Graduation Rates
#--------------------------------------------------------------------------------------------------------------------------------------------------------
#create visual showing ELL graduation rates 
ggplot(data=MA_high_schools, aes(x=Allgradrate, y=ELgradrate, size=number))+
  geom_point(mapping=aes(fill=factor(Top)), shape=21, alpha=.8)+
  scale_fill_manual(values=c("0"="steel blue",
                             "1"="forest green"),
                    labels= c("0"="Low Ranking",
                              "1"= "High Ranking"))+
  geom_text(aes(label=School), show.legend=F, size=4)+
  scale_size_continuous(range=c(2,12))+
  scale_y_continuous(breaks=c(20, 40, 60, 80, 100))+
  labs(title="Massachusetts ELL High School Graduation Rates by School Ranking",
       subtitle="ELL students tend to graduate at the same rates as their non-ELL peers.",
       caption="Source: Massachusetts Department of Elementary and Secondary Education",
       x="All Student Graduation Rate",
       y="ELL Student Graduation Rate"
       )+
  theme(strip.background=element_blank(),
        panel.background=element_blank())
