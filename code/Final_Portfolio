#Visual 1 ELL Teacher/Student Ratios
#--------------------------------------------------------------------------------------------------------------------------------------------------------
#read in and view data 
ELL_data_final <- read_excel("input/ELL_data_final.xlsx")
View(ELL_data_final)

#create visual comparing percentage of English language learner students to percentage of teachers 
ggplot(data=ELL_data_final,
       mapping = aes (x=PercentELL,
                      y=PercentTeachers,
                      color=ID))+
  geom_point(shape=16)+
  geom_text(aes(label=State, show.legend=F))+
  scale_color_manual(name="ID",
                     values= c("B" ="red",
                               "G" ="forest green"),
                     labels=c("B" ="Bad",
                              "G" = "Good"))+
  scale_x_continuous(limits=c(0,20))+
  scale_y_continuous(limits=c(0,50))+
  theme_minimal()+
  labs(title=paste("Ratio of English Learner Teachers to English Language Learners (ELLs), by State, 2018-2019"),
       caption = "Source: U.S. Department of Education, ED Data Express & National Center for Education Statistics",
       x = "% of English Language Learners (ELLs) in State",
       y="% of fully certified or licensed ELL teachers in State")
