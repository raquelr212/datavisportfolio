#Visual 5 Race #--------------------------------------------------------------------------------------------------------------------------------------------------------
#read in and view data 
dataviz2 <- read_excel("input/visual5.xlsx", 
                       sheet = "Sheet3")
View(dataviz2)

#create factor levels to sort data 
my_factor_levels <- c("indnative", "raceother", "asian", "black", "white")

#sort data by factor level
dataviz2$statnew <- factor(dataviz2$stat,
                           levels=my_factor_levels)

#create visual depicting racial makeup of states compared by resettlement model            
ggplot(data=dataviz2,
       aes(x=wf, y=pct, fill=statnew))+
  geom_bar(stat="identity")+
  theme(plot.margin=unit(c(1, 1, 1, 1), "cm"))+
  geom_text(aes(label=pct),
            position = position_stack(vjust=.5),
            size=3)+
  coord_flip()+
  scale_fill_manual(values = c("#B8E186",
                               "#E6F5D0",
                               "#F1B6DA",
                               "#DE77AE",
                               "Steel blue"))+
  theme(axis.title.x = element_blank(),
        axis.title.y=element_blank(),
        axis.ticks.x=element_blank(),
        axis.ticks.y=element_blank(),
        axis.text.x=element_blank(),
        panel.background=element_blank())
