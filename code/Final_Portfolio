#Visual 9 Refugee Job Seekers Caseloads
#--------------------------------------------------------------------------------------------------------------------------------------------------------
datavizthesisdata <- datavizthesisdata %>% 
  mutate(newwf=if_else(wf==0,"no","yes"))

datavizthesisdata <- datavizthesisdata %>% replace(is.na(.), 0)

datavizthesisdatastates <- datavizthesisdata %>%
  group_by(newwf, year) %>% summarize(caseloadnew=sum(caseload))

datavizthesisdatastates$newwf.fac <- as.factor(datavizthesisdatastates$newwf)
datavizthesisdatastates$newwf.fac <- fct_rev(datavizthesisdatastates$newwf)

ggplot(data=datavizthesisdatastates,
       aes(x=year, y=caseloadnew, fill=newwf.fac))+
  geom_bar(stat="identity", alpha=.8)+
  geom_text(aes(label=caseloadnew))+
  scale_fill_manual(values = c("no"="steel blue",
                               "yes"="orange"),
                    labels = c("no"= "Traditional Model",
                               "yes" = "Wilson/Fish"))+
  scale_color_manual(values = c("no"="steel blue",
                                "yes"="orange"),
                     labels = c("no"= "Traditional Model",
                                "yes" = "Wilson/Fish"))+
